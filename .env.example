# 이 파일을 .env.local 로 복사한 뒤 채우세요.

# 국토교통부 아파트 매매/전월세 실거래가 (data.go.kr 에서 두 API 활용신청 → 일반 인증키)
DATA_GO_KR_KEY=

# 한국은행 ECOS Open API 인증키 (ecos.bok.or.kr/api)
ECOS_KEY=

# DB (기본: 로컬 SQLite 파일 ./data/home.db). Turso 등 원격 libsql 도 가능
# DATABASE_URL=file:./data/home.db
# DATABASE_AUTH_TOKEN=

# 앱 내 배치 스케줄러 끄기 (cron/launchd 로 `npm run batch` 를 돌릴 때)
# BATCH_IN_APP=0

# 에이전트 CLI 경로 (PATH 에 없을 때만)
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# AGY_BIN=agy
# GEMINI_BIN=gemini

# KB부동산 자동 수집 끄기
# KB_DISABLED=1

# 네이버 호가: 합법적인 데이터 엔드포인트가 있을 때만
# NAVER_API_URL=https://.../complexes/{complexNo}/articles?area={area}
